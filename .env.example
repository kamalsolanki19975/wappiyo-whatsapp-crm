# ==============================================================================
# WAPPIYO SAAS APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# In production, set APP_ENV=production, APP_DEBUG=false, and generate APP_KEY.

APP_NAME=Wappiyo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wappiyo
DB_USERNAME=wappiyo_user
DB_PASSWORD=

# ------------------------------------------------------------------------------
# CACHE, SESSION & QUEUE DRIVERS
# ------------------------------------------------------------------------------
# In production, redis or database is recommended for scalable background queues
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

# ------------------------------------------------------------------------------
# REDIS (OPTIONAL / PRODUCTION RECOMMENDED)
# ------------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MAIL SERVICE (SMTP / RESEND)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# ------------------------------------------------------------------------------
# REALTIME BROADCASTING (PUSHER / SOKETI / LARAVEL WEBSOCKETS)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Frontend Vite Realtime Variables (Exposed to client for WebSocket connection)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------------------
# AWS S3 STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# WHATSAPP CLOUD API & META GRAPH API
# ------------------------------------------------------------------------------
# Organization-level WhatsApp credentials can be configured per tenant in Settings.
# System default/fallback settings:
GRAPH_API_VERSION=v19.0
DEMO_NUMBER=

# ------------------------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE (OPENAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# PAYMENT GATEWAYS (STRIPE / PAYPAL / PAYSTACK / FLUTTERWAVE)
# ------------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
