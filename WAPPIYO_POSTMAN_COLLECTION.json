                "{{contactUuid}}"
              ]
            },
            "description": "Updates contact details by UUID. Enforces tenant boundary isolation."
          }
        },
        {
          "name": "Delete Contact",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contacts/{{contactUuid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts",
                "{{contactUuid}}"
              ]
            },
            "description": "Soft deletes a contact record by UUID."
          }
        }
      ]
    },
