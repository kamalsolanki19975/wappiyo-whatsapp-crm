    {
      "name": "6. Canned Replies & Automation",
      "description": "Instant canned response templates and keyword auto-reply rules",
      "item": [
        {
          "name": "List Canned Replies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/canned-replies?page=1&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "canned-replies"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Lists all configured canned auto-replies."
          }
        },
        {
          "name": "Create Canned Reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
